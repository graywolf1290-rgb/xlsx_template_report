<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_xlsx_report" model="ir.module.category">
        <field name="name">Excel Reports</field>
        <field name="sequence">90</field>
    </record>

    <record id="res_groups_privilege_xlsx_report" model="res.groups.privilege">
        <field name="name">Excel Reports</field>
        <field name="sequence">90</field>
        <field name="category_id" ref="module_category_xlsx_report"/>
    </record>

    <record id="group_xlsx_report_user" model="res.groups">
        <field name="name">User: own reports</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_xlsx_report"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_xlsx_report_manager" model="res.groups">
        <field name="name">Manager: all reports</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_xlsx_report"/>
        <field name="implied_ids" eval="[Command.link(ref('group_xlsx_report_user'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>

    <record id="group_xlsx_report_sql" model="res.groups">
        <field name="name">SQL administrator</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_xlsx_report"/>
        <field name="implied_ids" eval="[Command.link(ref('group_xlsx_report_manager'))]"/>
        <field name="comment">Can write raw SQL data sources. SQL ignores record rules and
            multi-company restrictions: grant only to people who may read the whole database.</field>
    </record>
</odoo>
